VITE_PUBLIC_ENVIRONMENT=development
VITE_PUBLIC_APP_VERSION=0.0.0
VITE_PUBLIC_PROJECT_SHORT_NAME=Centro Médico Belgrano

# Modo de autenticación
# sanctum   : datos y login contra cmb-be (token personal de Laravel Sanctum)
# prototype : todo resuelto en el navegador, sin backend
VITE_AUTH_MODE=sanctum

# API de cmb-be
VITE_API_URL=http://localhost:8000/api/v1

VITE_APP_PORT=3000
